{
  "name": "TestSubmission",
  "type": "object",
  "properties": {
    "test_id": {
      "type": "string"
    },
    "room_id": {
      "type": "string"
    },
    "student_id": {
      "type": "string"
    },
    "student_name": {
      "type": "string"
    },
    "answers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "question_id": {
            "type": "string"
          },
          "answer": {
            "type": "string"
          },
          "answers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "is_correct": {
            "type": "boolean"
          },
          "time_spent_seconds": {
            "type": "number"
          }
        }
      }
    },
    "score": {
      "type": "number"
    },
    "total_questions": {
      "type": "number"
    },
    "total_time_seconds": {
      "type": "number"
    },
    "is_complete": {
      "type": "boolean",
      "default": false
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "test_id",
    "room_id",
    "student_id"
  ]
}