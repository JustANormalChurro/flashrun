{
  "name": "Test",
  "type": "object",
  "properties": {
    "room_id": {
      "type": "string",
      "description": "Room this test belongs to"
    },
    "title": {
      "type": "string",
      "description": "Test title"
    },
    "description": {
      "type": "string",
      "description": "Test description"
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "question_text": {
            "type": "string"
          },
          "question_type": {
            "type": "string"
          },
          "choices": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "correct_answer": {
            "type": "string"
          },
          "correct_answers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "image_url": {
            "type": "string"
          },
          "video_url": {
            "type": "string"
          }
        }
      }
    },
    "randomize_questions": {
      "type": "boolean",
      "default": false
    },
    "save_progress": {
      "type": "boolean",
      "default": true
    },
    "require_access_code": {
      "type": "boolean",
      "default": false
    },
    "access_code": {
      "type": "string"
    },
    "is_published": {
      "type": "boolean",
      "default": false
    },
    "time_limit_minutes": {
      "type": "number"
    },
    "show_score_to_student": {
      "type": "boolean",
      "default": true,
      "description": "Whether students can see their score after completing the test"
    }
  },
  "required": [
    "room_id",
    "title"
  ]
}