{
  "name": "Announcement",
  "type": "object",
  "properties": {
    "room_id": {
      "type": "string",
      "description": "Room this announcement belongs to"
    },
    "title": {
      "type": "string",
      "description": "Announcement title"
    },
    "content": {
      "type": "string",
      "description": "Markdown content"
    },
    "author_id": {
      "type": "string"
    },
    "author_name": {
      "type": "string"
    },
    "allow_comments": {
      "type": "boolean",
      "default": true
    },
    "allow_likes": {
      "type": "boolean",
      "default": true
    },
    "likes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "comments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "author_id": {
            "type": "string"
          },
          "author_name": {
            "type": "string"
          },
          "content": {
            "type": "string"
          },
          "created_at": {
            "type": "string"
          },
          "is_teacher_reply": {
            "type": "boolean"
          }
        }
      }
    }
  },
  "required": [
    "room_id",
    "title",
    "content"
  ]
}